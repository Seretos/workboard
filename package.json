{
  "name": "workboard",
  "version": "0.0.0",
  "description": "A pinnable desktop board that surfaces your assigned tickets and spins up per-ticket worktrees, virtual desktops, and dev environments to parallelize agent-driven work.",
  "author": "Arne von Appen",
  "license": "MIT",
  "main": "out/main/main.js",
  "scripts": {
    "build": "electron-vite build",
    "start": "electron .",
    "dev": "electron-vite dev",
    "dev:browser": "vite --config electron.vite.config.ts",
    "test": "vitest run",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "dompurify": "^3.0.0",
    "marked": "^13.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/dompurify": "^3.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.0.0"
  },
  "build": {
    "appId": "com.seretos.workboard",
    "productName": "Workboard",
    "icon": "assets/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "assets/icon.png"
      }
    ],
    "artifactName": "${name}-${version}-${os}.${ext}",
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "backend-bin/windows/workboard-backend.exe",
          "to": "backend/workboard-backend.exe"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "extraResources": [
        {
          "from": "backend-bin/mac/workboard-backend",
          "to": "backend/workboard-backend"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "extraResources": [
        {
          "from": "backend-bin/linux/workboard-backend",
          "to": "backend/workboard-backend"
        }
      ]
    }
  }
}
